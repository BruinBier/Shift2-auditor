{
  "name": "shift2-auditor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:check": "node -e \"require('@prisma/client').PrismaClient && console.log('✅ Database connected')\" || echo '❌ Database connection failed'",
    "db:fix": "prisma generate && echo '✅ Prisma client regenerated'",
    "schema:update": "prisma migrate deploy && prisma generate && echo '✅ Schema updated - you can now run: npm run dev'",
    "export": "node scripts/export-report-simple.js",
    "backup": "tsx scripts/export-all-data.ts",
    "restore": "tsx scripts/import-all-data.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tiptap/extension-image": "^2.1.13",
    "@tiptap/extension-link": "^2.1.13",
    "@tiptap/extension-text-align": "^2.1.13",
    "@tiptap/extension-underline": "^2.1.13",
    "@tiptap/react": "^2.1.13",
    "@tiptap/starter-kit": "^2.1.13",
    "adm-zip": "^0.5.16",
    "axe-core": "^4.11.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "docxtemplater": "^3.68.3",
    "encoding": "^0.1.13",
    "exceljs": "^4.4.0",
    "html-to-docx": "^1.8.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "marked": "^17.0.1",
    "md-editor-rt": "^6.3.1",
    "next": "14.2.18",
    "openai": "^6.17.0",
    "pizzip": "^3.2.0",
    "puppeteer": "^24.36.1",
    "puppeteer-ui-testkit": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/turndown": "^5.0.6",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
