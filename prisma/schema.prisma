// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id              String   @id @default(uuid())
  name            String   @default("Shift2")
  language        String   @default("Nederlands")
  address         String?  @db.Text
  email           String?
  phone           String?
  website         String?
  about           String?  @db.Text
  logoUrl         String?  @map("logo_url")
  useCardanAI     Boolean  @default(true) @map("use_cardan_ai")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("teams")
}

model Settings {
  id                    String   @id @default(uuid())
  key                   String   @unique
  value                 String   @db.Text
  description           String?  @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ResearchType {
  id                String                      @id @default(uuid())
  name              String                      @unique
  version           String
  level             String
  type              String
  description       String?                     @db.Text
  reportIntroHeader String?                     @db.Text @map("report_intro_header")
  reportIntro       String?                     @db.Text @map("report_intro")
  reportIntroPdf    String?                     @db.Text @map("report_intro_pdf")
  summaryTemplate   String?                     @db.Text @map("summary_template")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  criteria          ResearchTypeWCAGCriterion[]

  @@map("research_types")
}

model ResearchTypeWCAGCriterion {
  id              String        @id @default(uuid())
  researchTypeId  String        @map("research_type_id")
  wcagCriterionId String        @map("wcag_criterion_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  researchType    ResearchType  @relation(fields: [researchTypeId], references: [id], onDelete: Cascade)
  wcagCriterion   WCAGCriterion @relation(fields: [wcagCriterionId], references: [id], onDelete: Cascade)

  @@unique([researchTypeId, wcagCriterionId])
  @@map("research_type_wcag_criteria")
}

model Opdrachtgever {
  id             String          @id @default(uuid())
  kenmerk        String          @unique
  naam           String
  projectnummer  String?
  contactnaam    String?
  contactEmail   String?         @map("contact_email")
  accountmanager String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  clientProjects ClientProject[]

  @@map("opdrachtgevers")
}

model ClientProject {
  id              String        @id @default(uuid())
  name            String
  projectnummer   String?
  opdrachtgeverId String        @map("opdrachtgever_id")
  details         String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  opdrachtgever   Opdrachtgever @relation(fields: [opdrachtgeverId], references: [id], onDelete: Cascade)
  projects        Project[]

  @@map("client_projects")
}

model Project {
  id                      String         @id @default(uuid())
  kenmerk                 String?
  title                   String
  subject                 String
  standard                String         @default("WCAG 2.2")
  level                   String         @default("AA")
  researchType            String         @map("research_type")
  version                 Float          @default(1.0)
  language                String         @default("Nederlands")
  status                  String         @default("In uitvoering")
  clientName              String?        @map("client_name")
  commissionedBy          String?        @map("commissioned_by")
  clientProjectId         String?        @map("client_project_id")
  auditedByOrg            String         @default("Shift2") @map("audited_by_org")
  researcherName          String?        @map("researcher_name")
  /// De sales die dit onderzoek binnenhaalde. Staat ook op de opdrachtgever,
  /// maar kan per onderzoek afwijken; die waarde is de standaard bij het
  /// aanmaken.
  accountmanager          String?
  controllerName          String?        @map("controller_name")
  plannedTime             String?        @map("planned_time")
  dateStart               DateTime?      @map("date_start")
  dateEnd                 DateTime?      @map("date_end")
  researchStartedOn       DateTime?      @map("research_started_on")
  reportDate              DateTime       @default(now()) @map("report_date")
  description             String?        @db.Text
  notes                   String?        @db.Text
  isAnonymous             Boolean        @default(false) @map("is_anonymous")
  isPrivate               Boolean        @default(false) @map("is_private")
  /// Een proeftuin: intern werk om de werkwijze te verfijnen, geen klantonderzoek.
  ///
  /// Staat niet in de lijst met onderzoeken; daar horen alleen de echte onderzoeken te
  /// staan. Een schakelaar boven de lijst haalt ze erbij.
  ///
  /// Waarom een veld en niet een afspraak over de naam: "TEST-" vooraan werkt alleen zolang
  /// iedereen die afspraak kent en er niets op filtert. Hier kan code op beslissen. Op
  /// 2026-08-31 zijn er in de proeftuin akkoorden vervallen en is er een oordeel
  /// overschreven -- dat mocht, maar niets in het systeem wist dat het een proeftuin was.
  isProeftuin             Boolean        @default(false) @map("is_proeftuin")

  // Rich text fields
  summaryText             String?        @map("summary_text") @db.Text
  researcherFeedbackText  String?        @map("researcher_feedback_text") @db.Text
  aboutResearchText       String?        @map("about_research_text") @db.Text
  whatWasTestedText       String?        @map("what_was_tested_text") @db.Text
  aboutOrgText            String?        @map("about_org_text") @db.Text
  scopeInfo               String?        @map("scope_info") @db.Text
  sampleInfo              String?        @map("sample_info") @db.Text
  conclusionText          String?        @map("conclusion_text") @db.Text
  managementSummary       String?        @map("management_summary") @db.Text
  researcherFeedback      String?        @map("researcher_feedback") @db.Text

  // Method info
  methodName              String?        @map("method_name")
  techniquesNote          String?        @map("techniques_note") @db.Text
  supportBaseline         String?        @map("support_baseline") @db.Text
  userAgents              String?        @map("user_agents") @db.Text
  technologies            String[]       @default([]) @map("technologies")

  // Herinspectie fields
  parentProjectId         String?        @map("parent_project_id")
  hasReinspection         Boolean        @default(false) @map("has_reinspection")
  reinspectionWeeks       Int?           @map("reinspection_weeks")
  reinspectionDate        DateTime?      @map("reinspection_date") @db.Timestamp(6)
  cancellationReason      String?        @map("cancellation_reason") @db.Text

  // Tussencheck / Herinspectie fase
  checkPhase              ProjectCheckPhase @default(nulmeting) @map("check_phase")
  checkPhaseStartedAt     DateTime?      @map("check_phase_started_at")
  interimCheckLabel       String?        @map("interim_check_label")

  // Planning fields
  // De eerste twee stappen van het voorbereidingsproces gebeuren buiten de
  // tool (mail in Outlook, gesprek in Teams) en worden daarom met de hand
  // afgevinkt. De datum legt vast wanneer het gebeurde.
  invitationSent          DateTime?      @map("invitation_sent")
  scopeCallHeld           DateTime?      @map("scope_call_held")
  /// Transcript van het scopegesprek; de bron voor de scope-afspraken.
  scopeCallTranscript     String?        @map("scope_call_transcript") @db.Text
  // @db.Timestamp(6) volgt de kolommen zoals ze in de database staan. Deze twee
  // zijn met een kale TIMESTAMP aangemaakt, en dat is in PostgreSQL precisie 6;
  // zonder de annotatie wil Prisma ze naar timestamp(3) omzetten. De intakevelden
  // hierboven zijn wel als TIMESTAMP(3) aangemaakt en blijven daarom kaal.
  planningSent            DateTime?      @map("planning_sent") @db.Timestamp(6)
  planningApproved        DateTime?      @map("planning_approved") @db.Timestamp(6)
  /// Het adviesgesprek na de oplevering van de nulmeting: de resultaten doornemen en de
  /// vervolgstappen bespreken, voordat de klant aan het herstellen gaat.
  ///
  /// Hoort bij een onderzoek met hertest -- de planningsmail belooft het gesprek daar ook,
  /// en zonder hertest valt die alinea weg. Tot nu toe stond nergens of het gesprek ook
  /// gevoerd was; de klant kreeg de toezegging en de tool wist er niets van.
  ///
  /// Twee velden en niet een: tussen de uitnodiging en het gesprek zit wachttijd, net als
  /// bij het scopegesprek. Met een veld zou een verstuurde uitnodiging waar niemand op
  /// reageert er hetzelfde uitzien als een uitnodiging die nooit verstuurd is.
  adviceCallInvited       DateTime?      @map("advice_call_invited")
  adviceCallHeld          DateTime?      @map("advice_call_held")
  scopeInScope            String?        @map("scope_in_scope") @db.Text
  scopeOutOfScope         String?        @map("scope_out_of_scope") @db.Text
  sampleClientPages       String?        @map("sample_client_pages") @db.Text

  // External project fields
  isExternalProject       Boolean        @default(false) @map("is_external_project")
  /// Doorlopend werk zonder begin- en einddatum, zoals template-monitoring.
  /// Krijgt een eigen sectie in de onderzoekenlijst, want het hoort niet
  /// tussen de onderzoeken met een planning.
  isOngoing               Boolean        @default(false) @map("is_ongoing")
  externalBureau          String?        @map("external_bureau")

  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  // Relations
  clientProject           ClientProject? @relation(fields: [clientProjectId], references: [id], onDelete: SetNull)
  parentProject           Project?       @relation("ProjectHerinspectie", fields: [parentProjectId], references: [id], onDelete: SetNull)
  childProjects           Project[]      @relation("ProjectHerinspectie")
  scopeUrls               ProjectScopeUrl[]
  sampleItems             SampleItem[]
  criterionAssessments    CriterionAssessment[]
  findings                Finding[]
  waarnemingen            Waarneming[]
  planningChanges         ProjectPlanningChange[]
  projectNotes            ProjectNote[]
  crawlerRuns             CrawlerRun[]
  advices                 ProjectAdvice[]

  @@map("projects")
}

/// Verschuivingen van de planning, met de reden erbij. Zo is achteraf te
/// verantwoorden waarom een herinspectie later heeft plaatsgevonden dan
/// oorspronkelijk gepland. Elke verschuiving is een eigen regel, zodat ook
/// een tweede of derde uitstel zichtbaar blijft.
model ProjectPlanningChange {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  oldDateStart  DateTime? @map("old_date_start")
  oldDateEnd    DateTime? @map("old_date_end")
  newDateStart  DateTime? @map("new_date_start")
  newDateEnd    DateTime? @map("new_date_end")
  reason        String   @db.Text
  authorName    String   @map("author_name")
  createdAt     DateTime @default(now()) @map("created_at")

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_planning_changes")
}

model ProjectNote {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  authorName  String   @map("author_name")
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_notes")
}

model ProjectScopeUrl {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  url         String
  title       String?
  crawlerType String?  @map("crawler_type")
  inScope     Boolean  @default(true) @map("in_scope")
  note        String?  @db.Text
  crawledAt   DateTime? @map("crawled_at")
  parentUrlId String?  @map("parent_url_id")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentUrl   ProjectScopeUrl? @relation("DiscoveredUrls", fields: [parentUrlId], references: [id], onDelete: Cascade)
  discoveredUrls ProjectScopeUrl[] @relation("DiscoveredUrls")
  crawlerResults CrawlerResult[]
  findingUrls FindingUrl[]

  @@map("project_scope_urls")
}

enum SampleType {
  structured
  random
  pdf
}

model SampleItem {
  id             String       @id @default(uuid())
  projectId      String       @map("project_id")
  sampleType     SampleType   @map("sample_type")
  title          String
  url            String?
  description    String?      @db.Text
  orderIndex     Int?         @map("order_index")
  makeScreenshot Boolean      @default(false) @map("make_screenshot")
  screenshotPath String?      @map("screenshot_path")
  screenshotAlt  String?      @map("screenshot_alt")
  auditHtmlPath  String?      @map("audit_html_path")
  auditCapturedAt DateTime?   @map("audit_captured_at")
  /// Door een agent voorgesteld en nog niet door de onderzoeker bekeken.
  ///
  /// Een steekproef bepaalt waar gekeken wordt, en wat er niet in zit ontbreekt
  /// geruisloos in het rapport -- daar is achteraf niets aan te zien. `audit-samples`
  /// neemt bovendien ALLE sample-items mee, dus zonder deze vlag zou er een volledige
  /// audit draaien op pagina's die niemand heeft nagekeken.
  ///
  /// Vervalt per pagina: een knop bij de rij, en zelf een sample bewerken telt ook
  /// als bekeken. Slepen niet -- dat loopt via de reorder-route, en de lijst schikken
  /// is iets anders dan hem beoordelen.
  voorgesteld    Boolean      @default(false)
  /// Deze sample is ooit door een agent voorgesteld, ook als hij inmiddels is
  /// goedgekeurd. Blijft staan waar `voorgesteld` vervalt.
  ///
  /// Zonder dit veld is "goedgekeurd voorstel" niet te onderscheiden van "zelf
  /// ingevoerd": allebei staan op voorgesteld=false. Dan zegt een vinkje op de kaart
  /// niets meer. Nu wel: een vinkje betekent dat er een voorstel lag en dat je het
  /// hebt nagekeken.
  vanAgent       Boolean      @default(false) @map("van_agent")
  notes          String?      @db.Text
  crawledAt      DateTime?    @map("crawled_at")

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  occurrences    FindingOccurrence[]
  crawlerResults CrawlerResult[]
  waarnemingen   Waarneming[]
  criterionChecks SampleCriterionCheck[]

  @@map("sample_items")
}

/// Beoordeling van één succescriterium op één steekproefitem.
///
/// Waarom naast CriterionAssessment: dat model legt de status per PROJECT vast en zegt dus
/// niets over de vraag of pagina 7 daadwerkelijk op 2.4.6 is nagelopen. Zonder deze tabel is
/// een overgeslagen criterium onzichtbaar: geen bevinding kan "alles in orde" betekenen of
/// "hier is niet naar gekeken".
///
/// De project-brede status in CriterionAssessment wordt hieruit afgeleid: staat er ergens een
/// afkeuring, dan is het criterium afgekeurd. Alleen opmerkingen tellen als goedgekeurd.
model SampleCriterionCheck {
  id              String                @id @default(uuid())
  sampleItemId    String                @map("sample_item_id")
  wcagCriterionId String                @map("wcag_criterion_id")
  status          SampleCheckStatus
  /// Toelichting van de auditor: waarom deze status, of de vraag die nog beantwoord moet worden.
  reden           String?               @db.Text
  /// Waar het oordeel vandaan komt, zodat bij twijfel te herleiden is wie het vaststelde.
  bron            SampleCheckBron       @default(workflow)
  /// Alleen relevant bij een voorstel-bevinding: is die aan de onderzoeker voorgelegd en akkoord?
  akkoord         SampleCheckAkkoord?
  /// De metingen waarop dit oordeel rust, uit het logboek van de audit-CLI.
  ///
  /// Bewust buiten `reden`: een akkoord vervalt zodra die tekst verandert, en dan zou
  /// een nieuwe meting stilzwijgend de goedkeuring van de onderzoeker intrekken. Ook
  /// bewust niet door een agent geschreven — dat maakt er weer een bewering van. De
  /// CLI legt vast wat hij draait, de workflow koppelt dat aan het sample.
  ///
  /// Leeg betekent dat er geen meting aan te pas kwam. Dat is geen gebrek maar
  /// informatie: bij een oordeel uit een gesprek hoort hier niets te staan.
  verantwoording  Json?
  /// De uitkomst van de verificatie: per punt uit Shift2_Bewijsvoering.md of de
  /// onderbouwing eraan voldoet. Een verifieerder mag hier "nee" zeggen terwijl het
  /// oordeel zelf klopt — een onterecht "voldoet" valt anders niemand op.
  controle        Json?
  /// De onderdelen die de onderzoeker zélf vond, naast wat de meting vond.
  ///
  /// Een meting vindt niet alles: een onderdeel dat pas na een klik verschijnt, een
  /// pagina buiten de steekproef, of twee elementen die de sleutel niet koppelt. Wat de
  /// auditor met eigen ogen vindt hoort in dezelfde lijst als wat gemeten is.
  ///
  /// Bewust niet in `verantwoording` (dat is voor metingen uit het CLI-logboek) en niet
  /// in `reden` (dan zou toevoegen het akkoord laten vervallen).
  zelfGevonden    Json?                 @map("zelf_gevonden")
  /// Wat er per deelgebied is nagelopen, bij een criterium dat uit meerdere losse vragen
  /// bestaat.
  ///
  /// Welke gebieden dat zijn staat niet hier maar in het regelbestand van het criterium,
  /// onder `### Deelgebieden`; hier staat alleen de uitkomst per gebied. Zo blijft de lijst
  /// te wijzigen zonder migratie, en gaan bestaande oordelen niet stuk als er een gebied
  /// bijkomt — dat verschijnt dan als "nog niet nagelopen".
  ///
  /// Vorm: `[{ gebied: string, uitkomst: "ok" | "nvt" | "fout", toelichting?: string }]`.
  ///
  /// `nvt` is de reden dat deze kolom bestaat. Een onderbouwing in lopende tekst maakt geen
  /// verschil tussen "geen tabellen op deze pagina" en "niet naar tabellen gekeken": een
  /// verhaal dat iets weglaat leest hetzelfde als een verhaal dat niets te melden had. Bij
  /// BEV-03 (2026-08-04) stond 1.3.1 op `opmerking` met een onderbouwing over de
  /// koppenstructuur, terwijl er op diezelfde pagina `em`-elementen om gewone zinnen
  /// stonden — een afkeuring die er al was, gemist omdat niemand zag dat de andere twaalf
  /// gebieden niet waren nagelopen.
  ///
  /// Leeg betekent: nog niets nagelopen, of een criterium dat maar één vraag stelt.
  gebieden        Json?
  checkedAt       DateTime              @default(now()) @map("checked_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  sampleItem      SampleItem            @relation(fields: [sampleItemId], references: [id], onDelete: Cascade)
  wcagCriterion   WCAGCriterion         @relation(fields: [wcagCriterionId], references: [id])

  @@unique([sampleItemId, wcagCriterionId])
  @@map("sample_criterion_checks")
}

/// Bewust een eigen enum naast AssessmentStatus: daar staat `not_tested` voor twee dingen die
/// hier uit elkaar moeten blijven. `niet_te_bepalen` betekent "beoordeeld, maar er staat nog
/// een vraag open" en blokkeert het afronden; `niet_aanwezig` is een afgerond oordeel.
enum SampleCheckStatus {
  voldoet
  afgekeurd
  opmerking
  niet_aanwezig
  niet_te_bepalen
}

enum SampleCheckBron {
  workflow
  gesprek
  handmatig
}

enum SampleCheckAkkoord {
  voorgesteld
  akkoord
  afgewezen
}

enum WCAGLevel {
  A
  AA
  AAA
}

enum WCAGPrinciple {
  Perceivable
  Operable
  Understandable
  Robust
}

model WCAGCriterion {
  id                     String                      @id @default(uuid())
  code                   String                      @unique
  titleNl                String                      @map("title_nl")
  descriptionNl          String?                     @map("description_nl")
  level                  WCAGLevel
  principle              WCAGPrinciple
  guidelineCode          String                      @map("guideline_code")
  guidelineTitleNl       String                      @map("guideline_title_nl")
  guidelineDescriptionNl String?                     @map("guideline_description_nl")
  understandingUrl       String?                     @map("understanding_url")

  assessments         CriterionAssessment[]
  sampleChecks        SampleCriterionCheck[]
  findings            Finding[]
  researchTypes       ResearchTypeWCAGCriterion[]
  researchTypeExplanations ResearchTypeExplanation[]
  technicalIssues     TechnicalIssue[]
  advices             ProjectAdvice[]

  @@map("wcag_criteria")
}

model ResearchTypeExplanation {
  id                  String        @id @default(uuid())
  researchTypeName    String        @map("research_type_name")
  wcagCriterionId     String        @map("wcag_criterion_id")
  explanation         String        @db.Text
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  wcagCriterion       WCAGCriterion @relation(fields: [wcagCriterionId], references: [id], onDelete: Cascade)

  @@unique([researchTypeName, wcagCriterionId])
  @@index([researchTypeName])
  @@map("research_type_explanations")
}

enum AssessmentStatus {
  passed          // Goedgekeurd
  failed          // Afgekeurd
  not_present     // Niet aanwezig
  unknown         // Onbekend
  not_tested      // Niet getest
}

model CriterionAssessment {
  id              String            @id @default(uuid())
  projectId       String            @map("project_id")
  wcagCriterionId String            @map("wcag_criterion_id")
  status          AssessmentStatus
  notes           String?           @db.Text
  explanation     String?           @db.Text

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wcagCriterion   WCAGCriterion     @relation(fields: [wcagCriterionId], references: [id])

  @@unique([projectId, wcagCriterionId])
  @@map("criterion_assessments")
}

/// Het oordeel van de onderzoeker: is dit een afkeuring of niet?
/// WCAG zijn minimale richtlijnen, dus soms is iets geen echte WCAG-fout maar
/// wel het benoemen waard. Bij een opmerking blijven impact en responsibility leeg.
enum FindingType {
  bevinding
  opmerking
}

/// De levensloop van een bevinding. `voorstel` is de poort: een voorstel bestaat
/// wel, maar telt nergens mee — niet in het criteriumoordeel, niet in de
/// statistieken, niet in het rapport. Zie docs/adr/0001-akkoord-als-poort.md.
///
/// voorstel -> open -> published -> resolved, met `afgewezen` als zijspoor.
/// Een afwijzing blijft bewaard met haar reden, zodat een volgende auditronde
/// dezelfde onterechte vondst niet opnieuw voorstelt.
enum FindingStatus {
  voorstel
  open
  published
  resolved
  afgewezen
}

/// De staat van een ruwe waarneming van de onderzoeker.
enum WaarnemingStatus {
  open
  uitgewerkt
  vervallen
}

enum FindingImpact {
  klein
  matig
  serieus
  kritiek
  onbekend
}

enum FindingResponsibility {
  redacteur
  ontwikkelaar
  ontwerper
  onbekend
}

enum ProjectCheckPhase {
  nulmeting
  tussencheck
  herinspectie
  afgerond
}

model QuickFinding {
  id              String                 @id @default(uuid())
  title           String
  description     String                 @db.Text
  advice          String                 @db.Text
  criterionCode   String                 @map("criterion_code")
  keywords        String?
  crawler         Boolean                @default(false)
  crawlerTestId   String?                @unique @map("crawler_test_id")
  status          FindingStatus?
  impact          FindingImpact?
  responsibility  FindingResponsibility?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@map("quick_findings")
}

model Finding {
  id                 String                    @id @default(uuid())
  projectId          String                    @map("project_id")
  findingCode        String                    @map("finding_code")
  wcagCriterionId    String                    @map("wcag_criterion_id")
  type               FindingType               @default(bevinding)
  status             FindingStatus             @default(open)
  impact             FindingImpact?
  responsibility     FindingResponsibility?
  description        String                    @db.Text
  advice             String                    @db.Text
  evidence           String?                   @db.Text
  notes              String?                   @db.Text
  sortOrder          Int                       @default(0) @map("sort_order")
  interimReviewed    Boolean                   @default(false) @map("interim_reviewed")
  interimNotes       String?                   @map("interim_notes") @db.Text
  discoveredInPhase  ProjectCheckPhase         @default(nulmeting) @map("discovered_in_phase")
  /// Wanneer de onderzoeker het voorstel waar heeft gemaakt. Leeg bij bestaande
  /// bevindingen: die datum is er niet meer, en wordt niet verzonnen.
  akkoordOp          DateTime?                 @map("akkoord_op")
  /// Waarom dit voorstel geen bevinding werd. Alleen gevuld bij `afgewezen`.
  afwijzingsreden    String?                   @db.Text
  /// Gevuld als de afwijzing was: "dit is techniek". Verwijst naar het issue dat
  /// daaruit is aangemaakt, zodat zichtbaar blijft waar de vondst heen ging.
  technicalIssueId   String?                   @map("technical_issue_id")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wcagCriterion   WCAGCriterion          @relation(fields: [wcagCriterionId], references: [id])
  technicalIssue  TechnicalIssue?        @relation(fields: [technicalIssueId], references: [id], onDelete: SetNull)
  occurrences     FindingOccurrence[]
  affectedUrls    FindingUrl[]
  attachments     FindingAttachment[]
  waarnemingen    Waarneming[]

  /// Vangnet tegen dubbele codes: vier routes kenden findingCode toe met een
  /// lezen-dan-schrijven zonder transactie, waardoor twee findings dezelfde
  /// code konden krijgen. Zie lib/finding-code.ts.
  @@unique([projectId, findingCode])
  @@map("findings")
}

/// Een ruwe observatie van de onderzoeker: "hier klopt iets niet", zonder
/// oordeel. Geen criterium, geen impact, geen tekst volgens de schrijfregels —
/// dat is juist het werk dat er nog aan moet gebeuren. Grondstof, geen bevinding.
///
/// Eigen model en geen Finding met een lege status: een bevinding heeft een
/// verplicht criterium, en dat bepalen is nu precies wat er nog moet gebeuren.
model Waarneming {
  id             String            @id @default(uuid())
  projectId      String            @map("project_id")
  /// De pagina waarop het is gezien. Leeg als de onderzoeker alleen een URL had.
  sampleItemId   String?           @map("sample_item_id")
  url            String?
  tekst          String            @db.Text
  screenshotPath String?           @map("screenshot_path")
  status         WaarnemingStatus  @default(open)
  /// Het voorstel dat hieruit is voortgekomen, zodra het systeem het heeft
  /// uitgewerkt. Zo blijft terug te zien waar een voorstel vandaan kwam.
  findingId      String?           @map("finding_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sampleItem SampleItem? @relation(fields: [sampleItemId], references: [id], onDelete: SetNull)
  finding    Finding?    @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@map("waarnemingen")
}

model FindingOccurrence {
  id            String      @id @default(uuid())
  findingId     String      @map("finding_id")
  sampleItemId  String      @map("sample_item_id")
  url           String?
  context       String?     @db.Text

  finding       Finding     @relation(fields: [findingId], references: [id], onDelete: Cascade)
  sampleItem    SampleItem  @relation(fields: [sampleItemId], references: [id], onDelete: Cascade)

  @@map("finding_occurrences")
}

model FindingUrl {
  id              String           @id @default(uuid())
  findingId       String           @map("finding_id")
  scopeUrlId      String           @map("scope_url_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  finding         Finding          @relation(fields: [findingId], references: [id], onDelete: Cascade)
  scopeUrl        ProjectScopeUrl  @relation(fields: [scopeUrlId], references: [id], onDelete: Cascade)

  @@unique([findingId, scopeUrlId])
  @@map("finding_urls")
}

model FindingAttachment {
  id              String           @id @default(uuid())
  findingId       String           @map("finding_id")
  fileName        String           @map("file_name")
  fileType        String           @map("file_type") // "image/png", "image/jpeg"
  fileSize        Int              @map("file_size") // bytes (max 20MB = 20971520)
  filePath        String           @map("file_path") // storage path
  createdAt       DateTime         @default(now()) @map("created_at")

  finding         Finding          @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@map("finding_attachments")
}

model CrawlerResult {
  id            String           @id @default(uuid())
  scopeUrlId    String?          @map("scope_url_id")
  sampleItemId  String?          @map("sample_item_id")
  testId        String           @map("test_id")
  testName      String           @map("test_name")
  found         Boolean
  count         Int              @default(0)
  details       String?          @db.Text // JSON string with test-specific details
  createdAt     DateTime         @default(now()) @map("created_at")

  scopeUrl      ProjectScopeUrl? @relation(fields: [scopeUrlId], references: [id], onDelete: Cascade)
  sampleItem    SampleItem?      @relation(fields: [sampleItemId], references: [id], onDelete: Cascade)

  @@map("crawler_results")
}

model CrawlerRun {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  status          String    @default("running") // running, completed, failed
  totalUrls       Int       @default(0) @map("total_urls")
  urlsProcessed   Int       @default(0) @map("urls_processed")
  urlsFailed      Int       @default(0) @map("urls_failed")
  totalIssues     Int       @default(0) @map("total_issues")
  criticalIssues  Int       @default(0) @map("critical_issues")
  config          String?   @db.Text // JSON string with crawler config
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("crawler_runs")
}

model TechnicalIssue {
  id              String                @id @default(uuid())
  title           String
  description     String                @db.Text
  request         String?               @db.Text
  wcagCriterionId String?               @map("wcag_criterion_id")
  impact          FindingImpact?
  supplier        String?
  status          TechnicalIssueStatus  @default(open)
  githubIssueUrl  String?               @map("github_issue_url")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  wcagCriterion   WCAGCriterion?         @relation(fields: [wcagCriterionId], references: [id])
  /// De voorstellen die hierheen zijn doorgezet.
  findings        Finding[]

  @@index([status])
  @@index([wcagCriterionId])
  @@map("technical_issues")
}

enum TechnicalIssueStatus {
  open
  resolved
}

model CmsParagraph {
  id          String                 @id @default(uuid())
  name        String
  slug        String                 @unique
  description String?                @db.Text
  order       Int                    @default(0)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  helpteksten CmsParagraphHelptext[]

  @@map("cms_paragrafen")
}

model CmsParagraphHelptext {
  id             String       @id @default(uuid())
  paragraphId    String       @map("paragraph_id")
  elementType    String       @map("element_type")
  title          String
  helpText       String       @map("help_text") @db.Text
  wcagCriteria   String?      @map("wcag_criteria")
  order          Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  paragraph      CmsParagraph             @relation(fields: [paragraphId], references: [id], onDelete: Cascade)
  screenshots    CmsHelptextScreenshot[]

  @@map("cms_paragraaf_helpteksten")
}

model CmsHelptextScreenshot {
  id         String               @id @default(uuid())
  helptextId String               @map("helptext_id")
  path       String
  caption    String?
  alt        String?
  order      Int                  @default(0)
  createdAt  DateTime             @default(now()) @map("created_at")

  helptext   CmsParagraphHelptext @relation(fields: [helptextId], references: [id], onDelete: Cascade)

  @@map("cms_helptext_screenshots")
}

model ProjectAdvice {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  title           String
  adviceText      String    @map("advice_text") @db.Text
  reasonText      String    @map("reason_text") @db.Text
  wcagCriterionId String?   @map("wcag_criterion_id")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wcagCriterion   WCAGCriterion? @relation(fields: [wcagCriterionId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("project_advices")
}

enum VideoGemeente {
  cranendonck
  heeze_leende
  valkenswaard
}

enum VideoFase {
  voorbereiden
  ondertiteling
  audiodescriptie
  transcript
  publiceren
}

enum VideoFaseStatus {
  todo
  bezig
  klaar
  nvt
}

// Video A2-gemeenten: standalone omgeving voor het toegankelijk maken van YouTube-video's.
// 5 vaste fasen per video (zie enum VideoFase). Max. 1 fase-timer tegelijk actief in het
// hele systeem — afgedwongen via een partieel-unieke index op video_phases.timer_started_at.
// Die index staat ALLEEN in de migratie-SQL (Prisma kan een partieel-unieke index met
// WHERE-clause niet uitdrukken); niet verwijderen bij een migrate diff.
model Video {
  id        String        @id @default(uuid())
  gemeente  VideoGemeente
  titel     String
  url       String
  notities  String?       @db.Text
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  phases    VideoPhase[]

  @@index([gemeente])
  @@map("videos")
}

model VideoPhase {
  id             String          @id @default(uuid())
  videoId        String          @map("video_id")
  phase          VideoFase
  status         VideoFaseStatus @default(todo)
  seconds        Int             @default(0)
  timerStartedAt DateTime?       @map("timer_started_at")
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  video          Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, phase])
  @@index([videoId])
  @@map("video_phases")
}
